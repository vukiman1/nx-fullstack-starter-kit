# Reference only. This file is never loaded as configuration — copy it to .env.local and
# fill in what you need. Defaults live in config/default.yml.
VITE_APP_NAME=My Workspace
VITE_APP_ENVIRONMENT=development
VITE_API_BASE_URL=http://localhost:3000/api
# Leave VITE_SENTRY_DSN empty to disable error tracking
VITE_SENTRY_DSN=
# Google One Tap client id (public); leave empty to disable Google login
VITE_GOOGLE_CLIENT_ID=
