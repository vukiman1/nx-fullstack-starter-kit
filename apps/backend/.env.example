# App
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:4200
LOG_LEVELS=error,warn,log

# Database (Docker)
# TLS is off by default here and on in production. Managed providers (Neon, Supabase, RDS) require
# it; a local container serves no TLS at all, so forcing it there fails the connection.
# Override only when needed — uncommenting these makes them win over the production defaults:
#   DB_TLS=true
#   REDIS_TLS=true
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=nestdb

# Redis (Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS
CORS_ORIGINS=http://localhost:4200

# JWT
JWT_SECRET=super-secret-key
JWT_ACCESS_TOKEN_EXPIRES_IN=15m

# Session
MAX_SESSIONS_PER_USER=5
# Refresh-token (session) lifetime — default vs "remember me" vs OAuth (Google One Tap)
SESSION_REFRESH_TTL=1d
SESSION_REFRESH_TTL_REMEMBER=60d
SESSION_REFRESH_TTL_OAUTH=30d

# Crypto
SECRET_KEY=yoursecretkeymustbe32characters!!

# Sentry (leave SENTRY_DSN empty to disable error tracking)
SENTRY_DSN=

# Email (leave RESEND_API_KEY empty to skip sending in local dev)
RESEND_API_KEY=
EMAIL_FROM=Acme <onboarding@resend.dev>

# CAPTCHA (Cloudflare Turnstile; leave disabled until you provide a secret key)
CAPTCHA_ENABLED=false
CAPTCHA_SECRET_KEY=

# Google One Tap (public client id; leave empty to disable Google login)
GOOGLE_CLIENT_ID=
