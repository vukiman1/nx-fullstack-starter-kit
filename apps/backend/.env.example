# App
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:4200
LOG_LEVELS=error,warn,log

# Database (Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=nestdb

# Redis (Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS
CORS_ORIGINS=http://localhost:4200

# JWT
JWT_SECRET=super-secret-key
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
JWT_ACCESS_TOKEN_EXPIRES_IN=15m

# Session
MAX_SESSIONS_PER_USER=5

# Crypto
SECRET_KEY=yoursecretkeymustbe32characters!!

# Sentry (leave SENTRY_DSN empty to disable error tracking)
SENTRY_DSN=

# Email (leave RESEND_API_KEY empty to skip sending in local dev)
RESEND_API_KEY=
EMAIL_FROM=Acme <onboarding@resend.dev>

# CAPTCHA (Cloudflare Turnstile; leave disabled until you provide a secret key)
CAPTCHA_ENABLED=false
CAPTCHA_SECRET_KEY=
